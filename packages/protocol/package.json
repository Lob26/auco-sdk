{
  "name": "@lob26/auco-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Wire contract of the Auco host ⇄ frame postMessage protocol: types, parsing, origins. No DOM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "vitest": "^5.0.3",
    "@types/node": "^24.19.0"
  }
}
