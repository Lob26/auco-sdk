{
  "name": "auco-sdk-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Auco",
  "repository": {
    "type": "git",
    "url": "https://github.com/auco-ai/sdk-integration-library.git"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "ci": "bash scripts/ci.sh",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "legacy (ESM)",
      "path": "packages/legacy/dist/index.mjs",
      "limit": "5 KB"
    },
    {
      "name": "legacy (CJS)",
      "path": "packages/legacy/dist/index.cjs",
      "limit": "5 KB"
    },
    {
      "name": "v2 core: protocol + embed (ESM, gzip)",
      "path": "packages/embed/dist/index.mjs",
      "import": "*",
      "gzip": true,
      "limit": "3 KB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@size-limit/preset-small-lib": "^14.1.0",
    "shellcheck": "^4.1.0",
    "size-limit": "^14.1.0",
    "typescript": "~7.0.2"
  }
}
